---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navigation Header -->
  <header class="header">
    <div class="container nav-content">
      <a href="#" class="brand">
        <img src="/Yelly.png" alt="Yelly logo" class="brand-logo" width="32" height="32" />
        <span class="brand-name">yelly</span>
        <span class="badge badge-version">v1.5.0</span>
      </a>

      <nav class="nav-links">
        <a href="#features">Features</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#autopilot">Autopilot</a>
        <a href="#compare">Compare</a>
        <a href="#compile">Build</a>
      </nav>

      <div class="nav-actions">
        <a
          href="https://github.com/heshan-jj/yely-by-jj"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          <svg class="icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
          <span>GitHub</span>
        </a>
        <a href="#download" class="btn btn-primary">Download</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container hero-layout">
        <div class="hero-text">
          <div class="pill">
            <span class="pill-dot"></span>
            Windows 10 / 11 • Zero Drivers • Zero Telemetry
          </div>
          <h1 class="hero-title">Keep your PC cool.<br />Without the bloat.</h1>
          <p class="hero-subtitle">
            A lightweight, zero-dependency Windows desktop & system tray utility.
            Replicates Outbyte Camomile’s <strong>CoolMode</strong> and live hardware monitoring
            in pure C# with no background services, no telemetry, and an 116 KB executable.
          </p>

          <div class="hero-cta" id="download">
            <a href="/downloads/YellySetup.exe" class="btn btn-lg btn-primary" download>
              <svg class="icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
              </svg>
              <span>Download Yelly Setup</span>
              <span class="btn-subtext">v1.5.0 • 2.1 MB</span>
            </a>

            <a href="/downloads/Yelly.exe" class="btn btn-lg btn-outline" download>
              <svg class="icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="12" y1="18" x2="12" y2="12" />
                <line x1="9" y1="15" x2="15" y2="15" />
              </svg>
              <span>Portable .exe</span>
              <span class="btn-subtext">Standalone • 116 KB</span>
            </a>
          </div>

          <div class="meta-row">
            <span>✓ Pure .NET 4.x WinForms</span>
            <span>✓ Inno Setup Installer</span>
            <span>✓ Per-Monitor DPI Scaled</span>
          </div>
        </div>

        <!-- Hero App Visual -->
        <div class="hero-visual">
          <div class="app-window">
            <div class="window-header">
              <div class="window-controls">
                <span class="dot close"></span>
                <span class="dot min"></span>
                <span class="dot max"></span>
              </div>
              <div class="window-title">Yelly - Hardware Telemetry & CoolMode</div>
              <span class="badge badge-accent">Active</span>
            </div>

            <div class="window-body">
              <!-- CoolMode Hero Card -->
              <div class="coolmode-card">
                <div class="coolmode-info">
                  <div class="coolmode-label">
                    <span class="status-indicator"></span>
                    <strong>CoolMode Engaged</strong>
                  </div>
                  <p class="coolmode-desc">CPU capped at 99% with aggressive boost disabled. Thermal output reduced by 12–18°C.</p>
                </div>
                <div class="coolmode-switch">
                  <span class="switch-pill active">ON</span>
                </div>
              </div>

              <!-- Metric Grid -->
              <div class="metrics-grid">
                <div class="metric-card">
                  <div class="metric-header">
                    <span class="metric-name">CPU Temperature</span>
                    <span class="badge badge-green">Cool (54°C)</span>
                  </div>
                  <div class="metric-val">54.0 <span class="unit">°C</span></div>
                  <div class="metric-sparkline">
                    <svg viewBox="0 0 120 28" class="spark-svg">
                      <path d="M0,20 Q20,18 40,22 T80,14 T120,16" fill="none" stroke="currentColor" stroke-width="2" />
                    </svg>
                  </div>
                  <div class="metric-foot">Load: 12% • Clock: 2.4 GHz</div>
                </div>

                <div class="metric-card">
                  <div class="metric-header">
                    <span class="metric-name">NVIDIA GPU</span>
                    <span class="badge badge-blue">Normal (46°C)</span>
                  </div>
                  <div class="metric-val">46.0 <span class="unit">°C</span></div>
                  <div class="metric-foot">Fan: 0% • Power: 18W • VRAM: 1.4 GB</div>
                </div>

                <div class="metric-card">
                  <div class="metric-header">
                    <span class="metric-name">Autopilot Engine</span>
                    <span class="badge badge-amber">Watching</span>
                  </div>
                  <div class="metric-val text-sm">Rules: Active</div>
                  <div class="metric-foot">Game rules: Standby • Battery: AC Line</div>
                </div>

                <div class="metric-card">
                  <div class="metric-header">
                    <span class="metric-name">NVMe Drive</span>
                    <span class="badge badge-green">Healthy</span>
                  </div>
                  <div class="metric-val">41.0 <span class="unit">°C</span></div>
                  <div class="metric-foot">Wear indicator: 99% remaining</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="section" id="how-it-works">
      <div class="container">
        <div class="section-header">
          <span class="badge badge-blue">Architecture</span>
          <h2 class="section-title">How CoolMode Works Under the Hood</h2>
          <p class="section-desc">
            Modern CPUs push boost clocks aggressively even for lightweight background tasks,
            causing sudden temperature spikes and noisy fan revs. Yelly gently throttles peak boost
            while maintaining 100% of fluid UI responsiveness.
          </p>
        </div>

        <div class="diagram-grid">
          <div class="card diagram-card">
            <h3>The 3-Step Execution Pipeline</h3>
            <p>Non-blocking hardware poll &rarr; Autopilot condition checks &rarr; Instant Win32 power scheme switch.</p>
            <div class="img-wrapper">
              <img src="/docs/how-it-works.svg" alt="How Yelly works: watch telemetry, decide with Autopilot, apply power-plan change" loading="lazy" />
            </div>
          </div>

          <div class="card diagram-card">
            <h3>CoolMode vs Full Performance</h3>
            <p>Capping processor state at 99% disables aggressive Intel Turbo Boost / AMD Precision Boost.</p>
            <div class="img-wrapper">
              <img src="/docs/modes.svg" alt="CoolMode caps processor at 99 percent with boost off" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="section bg-surface" id="features">
      <div class="container">
        <div class="section-header">
          <span class="badge badge-green">Capabilities</span>
          <h2 class="section-title">Engineered to be Invisible and Reliable</h2>
          <p class="section-desc">
            Everything you need to keep your laptop or desktop running whisper-quiet, with zero fluff.
          </p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon icon-blue">❄️</div>
            <h3>99% Processor Cap</h3>
            <p>
              Instantly limits the Windows maximum processor state from 100% to 99%, dropping thermal output by up to 20°C with no perceptible slowdown in day-to-day apps.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon icon-amber">🤖</div>
            <h3>Autopilot Automation</h3>
            <p>
              Automatically disables CoolMode when you launch heavy apps (like Cyberpunk 2077 or Blender) and re-engages it when you finish, or when running on battery.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon icon-green">📊</div>
            <h3>Rich Telemetry</h3>
            <p>
              Streams CPU model, per-logical core load, NVIDIA GPU wattage/fan/memory, physical NVMe SSD wear & temperature, RAM, and battery charging state.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon icon-red">🎯</div>
            <h3>Tray Icon Temperature</h3>
            <p>
              Direct 2-digit temperature rendering right inside your Windows system tray icon (Blue for CoolMode, Amber for Turbo, Red for thermal alerts).
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon icon-blue">⌨️</div>
            <h3>Global Hotkey</h3>
            <p>
              Toggle CoolMode from any game or app via your own custom key combination, complete with conflict detection if another program owns the shortcut.
            </p>
          </div>

          <div class="feature-card">
            <div class="feature-icon icon-green">⚡</div>
            <h3>Zero External Dependencies</h3>
            <p>
              Written in pure C# using built-in .NET 4.x WinForms and GDI+. No runtime runtimes to install, no Electron bloat, and compiles in 2 seconds.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Autopilot Deep Dive -->
    <section class="section" id="autopilot">
      <div class="container">
        <div class="section-header">
          <span class="badge badge-amber">Smart Automation</span>
          <h2 class="section-title">Autopilot Decision Engine</h2>
          <p class="section-desc">
            Autopilot continuously checks foreground process rules, battery state, and CPU thermals. The first matching rule immediately dictates power mode.
          </p>
        </div>

        <div class="split-layout">
          <div class="split-media card">
            <img src="/docs/autopilot.svg" alt="Autopilot decision tree" loading="lazy" />
          </div>

          <div class="split-content">
            <div class="rule-item">
              <span class="rule-num">1</span>
              <div>
                <h4>Process-Specific Detection</h4>
                <p>Add game or 3D rendering executables (e.g. <code>cyberpunk2077.exe</code>, <code>blender.exe</code>). Yelly yields full processor boost during high-demand workloads.</p>
              </div>
            </div>

            <div class="rule-item">
              <span class="rule-num">2</span>
              <div>
                <h4>Battery-Aware Throttling</h4>
                <p>When disconnected from AC wall power, Autopilot automatically locks CoolMode ON to extend mobile laptop battery life.</p>
              </div>
            </div>

            <div class="rule-item">
              <span class="rule-num">3</span>
              <div>
                <h4>Thermal Safety Threshold</h4>
                <p>Configure an automatic tripwire (e.g., 85°C) with built-in hysteresis to prevent thermal runaways and rapid mode switching.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tray Indicator Showcase -->
    <section class="section bg-surface">
      <div class="container">
        <div class="section-header">
          <span class="badge badge-blue">System Tray</span>
          <h2 class="section-title">Always Visible. Never Distracting.</h2>
          <p class="section-desc">
            Keep an eye on system temps without dedicating an entire monitor to bulky monitoring software.
          </p>
        </div>

        <div class="tray-showcase card">
          <img src="/docs/tray.svg" alt="System tray temperature indicator colors" loading="lazy" />
          <div class="tray-legend">
            <div class="legend-item"><span class="badge badge-blue">Blue</span> CoolMode active (capped 99%)</div>
            <div class="legend-item"><span class="badge badge-amber">Amber</span> Full boost performance</div>
            <div class="legend-item"><span class="badge badge-red">Red</span> Thermal alert threshold exceeded</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="section" id="compare">
      <div class="container">
        <div class="section-header">
          <span class="badge badge-green">Why Yelly</span>
          <h2 class="section-title">Honest Comparison</h2>
          <p class="section-desc">
            How Yelly compares to proprietary vendor utilities and bloated monitoring suites.
          </p>
        </div>

        <div class="table-container card">
          <table class="compare-table">
            <thead>
              <tr>
                <th>Feature / Metric</th>
                <th class="highlight">Yelly</th>
                <th>Outbyte Camomile</th>
                <th>OEM Utility Suites</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Kernel Driver Required</strong></td>
                <td class="highlight text-green">None (0)</td>
                <td class="text-red">Yes</td>
                <td class="text-red">Yes (multiple)</td>
              </tr>
              <tr>
                <td><strong>Background Telemetry / Tracking</strong></td>
                <td class="highlight text-green">None (0%)</td>
                <td class="text-red">Yes</td>
                <td class="text-red">Aggressive</td>
              </tr>
              <tr>
                <td><strong>Background Windows Services</strong></td>
                <td class="highlight text-green">0 Services</td>
                <td class="text-red">1+ Service</td>
                <td class="text-red">3–8 Services</td>
              </tr>
              <tr>
                <td><strong>Executable Size</strong></td>
                <td class="highlight text-green">116 KB</td>
                <td>~35 MB</td>
                <td class="text-red">300 MB – 1 GB</td>
              </tr>
              <tr>
                <td><strong>RAM Usage</strong></td>
                <td class="highlight text-green">&lt; 25 MB</td>
                <td>~90 MB</td>
                <td class="text-red">250 MB – 800 MB</td>
              </tr>
              <tr>
                <td><strong>Open Source Code</strong></td>
                <td class="highlight text-green">100% Open (C#)</td>
                <td class="text-red">Closed / Paid</td>
                <td class="text-red">Proprietary</td>
              </tr>
              <tr>
                <td><strong>Install Privilege Needed</strong></td>
                <td class="highlight text-green">Standard User</td>
                <td>Administrator</td>
                <td>Administrator</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Build / Compiling Section -->
    <section class="section bg-surface" id="compile">
      <div class="container">
        <div class="section-header">
          <span class="badge badge-amber">Developer Ready</span>
          <h2 class="section-title">Zero Build Tooling Overhead</h2>
          <p class="section-desc">
            Don't trust prebuilt binaries? You don't even need Visual Studio to compile Yelly.
            It builds in 2 seconds with Windows’ built-in C# compiler.
          </p>
        </div>

        <div class="card code-card">
          <div class="code-header">
            <span>Windows Command Prompt</span>
            <span class="badge badge-blue">csc.exe</span>
          </div>
          <pre><code>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe /target:winexe /optimize+ /r:System.Management.dll /win32icon:Yelly.ico /resource:Yelly.png /out:Yelly.exe Ui.cs Settings.cs Telemetry.cs Autopilot.cs MainForm.cs Yelly.cs</code></pre>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-content">
      <div class="footer-brand">
        <img src="/Yelly.png" alt="Yelly logo" width="24" height="24" />
        <span><strong>Yelly</strong> by Heshan Jayakody</span>
      </div>
      <div class="footer-links">
        <a href="https://github.com/heshan-jj/yely-by-jj" target="_blank" rel="noopener noreferrer">GitHub Repository</a>
        <a href="https://github.com/heshan-jj/yely-by-jj/releases" target="_blank" rel="noopener noreferrer">Releases</a>
        <a href="https://github.com/heshan-jj/yely-by-jj/issues" target="_blank" rel="noopener noreferrer">Issue Tracker</a>
        <a href="#download">Download</a>
      </div>
      <div class="footer-copy">
        Free & Open Source software for Windows. Built with pure C# and Astro.
      </div>
    </div>
  </footer>
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Header */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .brand-logo {
    border-radius: var(--radius-sm);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Badges & Pills */
  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    line-height: 1;
  }

  .badge-version {
    background: var(--surface-hover);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .badge-accent {
    background: var(--accent-bg);
    color: var(--accent);
  }

  .badge-blue {
    background: var(--accent-bg);
    color: var(--accent);
  }

  .badge-green {
    background: var(--green-bg);
    color: var(--green);
  }

  .badge-amber {
    background: var(--amber-bg);
    color: var(--amber);
  }

  .badge-red {
    background: var(--red-bg);
    color: var(--red);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-ghost {
    color: var(--text-muted);
  }

  .btn-ghost:hover {
    color: var(--text);
    background: var(--surface-hover);
  }

  .btn-primary {
    background: var(--accent);
    color: #ffffff;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
  }

  .btn-outline {
    background: var(--surface);
    border-color: var(--border-strong);
    color: var(--text);
  }

  .btn-outline:hover {
    background: var(--surface-hover);
  }

  .btn-lg {
    padding: 0.8rem 1.4rem;
    font-size: 1rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .btn-lg span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .btn-subtext {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.85;
  }

  /* Hero Section */
  .hero-section {
    padding: 4.5rem 0 3.5rem;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-title {
    font-size: 3.1rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .meta-row {
    display: flex;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: var(--text-subtle);
  }

  /* Mock App Window */
  .app-window {
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .window-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.close { background: #ff5f56; }
  .dot.min { background: #ffbd2e; }
  .dot.max { background: #27c93f; }

  .window-title {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .window-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .coolmode-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--accent-bg);
    border: 1px solid var(--accent);
    padding: 1rem;
    border-radius: var(--radius-md);
  }

  .coolmode-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--accent);
  }

  .status-indicator {
